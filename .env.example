# Postgres connection string used by Prisma (packages/db)
DATABASE_URL="postgresql://user:password@localhost:5432/humanfirst"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email transport (Nodemailer/SMTP)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="HumanFirst <no-reply@example.com>"

# Human Confidence Score thresholds (all optional, defaults shown — see packages/verification/src/config.ts)
# HCS_PASTE_VIOLATION_PENALTY_PER_COUNT=8
# HCS_PASTE_VIOLATION_PENALTY_CAP=100
# HCS_SUPERHUMAN_WPM_THRESHOLD=120
# HCS_SUPERHUMAN_WPM_PENALTY_PER_WPM_OVER=2
# HCS_SUPERHUMAN_WPM_PENALTY_CAP=40
# HCS_MIN_CHARS_FOR_BACKSPACE_CHECK=200
# HCS_NEAR_ZERO_BACKSPACE_RATIO_THRESHOLD=0.02
# HCS_NEAR_ZERO_BACKSPACE_PENALTY=15
# HCS_MIN_INTERVALS_FOR_CADENCE_CHECK=30
# HCS_UNIFORM_CADENCE_CV_THRESHOLD=0.15
# HCS_UNIFORM_CADENCE_PENALTY=15
# HCS_MULTI_SESSION_BONUS_PER_EXTRA_SESSION=3
# HCS_MULTI_SESSION_BONUS_CAP=10

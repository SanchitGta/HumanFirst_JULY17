# Postgres connection string used by Prisma (packages/db)
DATABASE_URL="postgresql://user:password@localhost:5432/humanfirst"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email transport (Nodemailer/SMTP)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="HumanFirst <no-reply@example.com>"

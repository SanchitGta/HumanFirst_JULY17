generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFTING
  LOCKED
  PUBLISHED
}

enum AIGenerationType {
  EXAMPLE
  AUDIENCE
  FAQ
  SUMMARY
  DIAGRAM
  HTML_APP
}

enum AIGenerationStatus {
  PENDING
  READY
  FAILED
}

enum SkillVisibility {
  PRIVATE
}

enum VersionActorType {
  USER
  SYSTEM
}

enum VersionEventType {
  HUMAN_DRAFT_LOCKED
  HUMAN_DRAFT_CORRECTED
  AI_GENERATION_CREATED
  ARTICLE_PUBLISHED
  ARTICLE_UNPUBLISHED
}

enum AnalyticsEventType {
  ARTICLE_VIEW
  AI_SECTION_EXPAND
  AI_SECTION_COLLAPSE
  DIAGRAM_INTERACTION
  HTML_APP_INTERACTION
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  handle        String    @unique // public /@handle segment, stored WITHOUT the leading "@"
  passwordHash  String?             // null for accounts created via OAuth/magic-link only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  articles  Article[]
  skills    Skill[]
  mcpTokens MCPToken[]
  auditLogs AuditLog[]
}

// Standard Auth.js Prisma-adapter models — required verbatim shape for @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Article {
  id             String        @id @default(cuid())
  authorId       String
  title          String
  slug           String
  status         ArticleStatus @default(DRAFTING)
  tags           String[]      @default([])
  seoDescription String?
  ogImageUrl     String?
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  draftRevision   DraftRevision?
  humanDrafts     HumanDraft[]
  aiGenerations   AIGeneration[]
  versions        Version[]
  analyticsEvents AnalyticsEvent[]

  @@unique([authorId, slug])
  @@index([status])
}

// The single mutable, autosaved, pre-lock working copy (US-15.4). 1:1 with Article — distinct from
// the append-only, immutable HumanDraft revisions below.
model DraftRevision {
  id        String @id @default(cuid())
  articleId String @unique

  contentJson         Json
  charsTypedNet       Int @default(0)
  charsTypedGross     Int @default(0)
  backspaceCount      Int @default(0)
  pasteViolationCount Int @default(0)
  activeTypingMs      Int @default(0)
  sessionCount        Int @default(0)

  // Welford running mean/variance aggregate for keystroke-interval cadence (US-3.2's
  // uniform-cadence penalty). variance = keystrokeIntervalM2 / keystrokeIntervalCount when count > 1.
  keystrokeIntervalCount  Int   @default(0)
  keystrokeIntervalMeanMs Float @default(0)
  keystrokeIntervalM2     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// Immutable once created (US-4.1, US-4.2). One row per lock/correction cycle, versionNumber increasing.
// DB-level immutability trigger (BEFORE UPDATE on contentJson/checksum) is added in story 12 alongside
// the lock/correction flow it protects — see spec Assumptions.
model HumanDraft {
  id             String @id @default(cuid())
  articleId      String
  revisionNumber Int

  contentJson             Json
  checksum                String // SHA-256 hex of contentJson
  typingAnalyticsSnapshot Json
  verificationResult      Json

  createdAt DateTime @default(now())

  article       Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  aiGenerations AIGeneration[]
  versions      Version[]

  @@unique([articleId, revisionNumber])
}

model AIGeneration {
  id            String             @id @default(cuid())
  articleId     String
  humanDraftId  String
  type          AIGenerationType
  status        AIGenerationStatus @default(PENDING)
  prompt        String             @db.Text
  model         String
  params        Json
  sourceSkillId String?
  contentJson   Json?
  order         Int                @default(0)
  hidden        Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article     Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  humanDraft  HumanDraft @relation(fields: [humanDraftId], references: [id])
  sourceSkill Skill?     @relation(fields: [sourceSkillId], references: [id])
  versions    Version[]

  @@index([articleId])
}

model Skill {
  id            String           @id @default(cuid())
  ownerId       String
  name          String
  expansionType AIGenerationType
  promptText    String           @db.Text
  audience      String?
  writingStyle  String?
  temperature   Float            @default(0.7)
  outputFormat  String?
  visibility    SkillVisibility  @default(PRIVATE) // marketplace-ready field; only PRIVATE used in POC UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  aiGenerations AIGeneration[]
}

model MCPToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique // SHA-256 hex of the raw PAT
  tokenPrefix String              // first 12 chars of the raw PAT, for list-view identification only
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId])
}

model AuditLog {
  id              String   @id @default(cuid())
  toolName        String
  principalUserId String?
  mcpTokenId      String?
  articleId       String?
  allowed         Boolean
  reason          String?

  createdAt DateTime @default(now())

  principal User?     @relation(fields: [principalUserId], references: [id])
  mcpToken  MCPToken? @relation(fields: [mcpTokenId], references: [id])

  @@index([mcpTokenId, createdAt])
  @@index([principalUserId, createdAt])
}

// Unified append-only history log (US-13.1). humanDraftId/aiGenerationId are mutually exclusive
// nullable FKs (exactly one set, depending on eventType) rather than a single polymorphic id column,
// so referential integrity is enforced by Postgres rather than left to application code.
model Version {
  id             String           @id @default(cuid())
  articleId      String
  eventType      VersionEventType
  actorType      VersionActorType
  actorId        String?
  humanDraftId   String?
  aiGenerationId String?
  metadata       Json?

  createdAt DateTime @default(now())

  article      Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  humanDraft   HumanDraft?   @relation(fields: [humanDraftId], references: [id])
  aiGeneration AIGeneration? @relation(fields: [aiGenerationId], references: [id])

  @@index([articleId, createdAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  articleId String
  type      AnalyticsEventType
  metadata  Json?

  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, type])
}

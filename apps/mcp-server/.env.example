PORT=3100

# Read-only role — see packages/db/sql/mcp_server_roles.sql. Deliberately not shared with
# apps/web's DATABASE_URL: that role has write access, this one must not.
DATABASE_URL="postgresql://humanfirst_mcp_reader:<password>@localhost:5432/humanfirst"

# Insert-only role, used only by src/audit.ts's raw pg client (never by Prisma).
MCP_AUDIT_DATABASE_URL="postgresql://humanfirst_mcp_audit:<password>@localhost:5432/humanfirst"

# MCP_RATE_LIMIT_PER_MINUTE=30
# MCP_RATE_LIMIT_WINDOW_MS=60000
